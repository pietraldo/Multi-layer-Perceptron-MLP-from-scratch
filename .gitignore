.venv/
__pycache__/

# MNIST: the IDX files are kept in their subfolders (that is where the loader reads them),
# the top-level copies are identical duplicates
/dane/mnist_dataset/*.idx*-ubyte
# original archives, the same data is already extracted in dane/
/dane/*.zip
/dane/*.tar.xz

# trained models: every training run is generated, only models/demo/ is kept
/models/mnist/run_*/

# experiment results and plots are generated by "python main.py run"
/wyniki/
/wykresy/
wyniki_trenowania_konsolka.txt
/raport/